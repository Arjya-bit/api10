# Threat Intelligence API Keys
# Copy this file to .env and fill in your API keys

# AlienVault OTX - https://otx.alienvault.com/
OTX_API_KEY=your_otx_api_key_here

# VirusTotal - https://www.virustotal.com/
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# PulseDive - https://pulsedive.com/
PULSEDIVE_API_KEY=your_pulsedive_api_key_here

# AbuseIPDB - https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Project Honeypot http:BL - https://www.projecthoneypot.org/httpbl_configure.php
HONEYPOT_API_KEY=your_httpbl_access_key_here

# HetrixTools - https://hetrixtools.com/
HETRIXTOOLS_API_KEY=your_hetrixtools_api_key_here

# Database Configuration
APIGUARDIAN_DB=/path/to/apiguardian.db
APIGUARDIAN_CONFIG=/path/to/configs/default.yaml
